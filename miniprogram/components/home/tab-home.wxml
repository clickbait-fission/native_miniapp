<scroll-view
        class="container"
        style="{{dynamicStyle}}"
        type="custom"
        scroll-y
        bind:scroll="onScroll">
    <view class="root">
        <view class="top-space"/>
        <view wx:for="{{shownMedias}}" wx:key="id" class="card">
            <media-brief media="{{item}}"/>
        </view>
        <view class="bottom-space"/>
    </view>
</scroll-view>